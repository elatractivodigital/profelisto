# Configuración opcional de proveedor IA (NUNCA subas tu archivo .env real a GitHub)
# Copia este archivo como ".env" si deseas conectar un LLM externo (OpenAI, Gemini compatible o endpoint propio).
# Si estas variables están vacías, ProfeListo usa automáticamente su Motor Pedagógico Local gratuito.

VITE_AI_API_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=gemini-2.5-flash
